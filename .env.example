# Copy to .env and fill in. Python scripts load .env automatically; shell
# scripts source it. Paths can also be exported in the shell instead.

# CHIRLA dataset root, the folder that holds benchmark/ and metadata/.
CHIRLA_ROOT=/path/to/CHIRLA

# Where embeddings, ensemble shortlists and VLM rerank outputs are written.
EXPERIMENTS_ROOT=/path/to/CHIRLA/experiments

# Host running the vLLM server (run_vllm_server.sh). Defaults to localhost.
# VLM_HOST=localhost

# Optional: folder with local copies of the VLM weights, e.g. $MODELS_DIR/Qwen3.6-27B.
# If unset, vLLM downloads them from the Hugging Face Hub.
# MODELS_DIR=/path/to/models
